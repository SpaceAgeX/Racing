SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-hosted-publishable-key
# Use the direct or Session pooler URL from your project's Connect panel.
# Keep this secret in .env.local; URL-encode reserved characters in the password.
# This example requires encryption. Use Supabase's root CA and certificate
# verification for production deployment.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require
# Set to true only after enabling Google in hosted Supabase Auth.
GOOGLE_SIGN_IN_ENABLED=false
