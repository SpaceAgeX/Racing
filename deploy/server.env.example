NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MAX_BROWSER_SESSIONS=15
TRACKS_FILE=/var/lib/racing/tracks.json
RACING_RECORDINGS_DIR=/var/lib/racing/recordings
# Required for the account-enabled release; use a fresh hosted Supabase project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
DATABASE_URL=postgresql://YOUR_DATABASE_CONNECTION_STRING
GOOGLE_SIGN_IN_ENABLED=true
